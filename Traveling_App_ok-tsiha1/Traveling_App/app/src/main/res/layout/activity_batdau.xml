<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.StartActivity">

    <!-- Ảnh nền chiếm phần trên, không cụt -->
    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="632dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/dulichvietnam" />

    <!-- Logo nổi trên ảnh -->
    <ImageView
        android:id="@+id/img1"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_alignTop="@id/img"
        android:layout_marginTop="70dp"
        android:layout_marginStart="220dp"
        android:src="@drawable/logo8" />

    <!-- Tiêu đề -->

    <!-- Mô tả ngắn -->

    <!-- Nút Bắt đầu: thấp vừa phải, căn giữa -->
    <TextView
        android:id="@+id/tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/img"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text="Khám phá Việt Nam với ứng dụng du lịch hàng đầu!"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv1"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="Bắt đầu cuộc phiêu lưu mới ngay hôm nay."
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:ignore="TextSizeCheck" />

    <Button
        android:id="@+id/btn1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv2"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"
        android:text="Bắt đầu"
        android:textAllCaps="false"
        android:background="@drawable/stroke_button1"
        android:textColor="@color/white" />

    <!-- Spinner (góc phải trên cùng) -->
    <Spinner
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:padding="10dp" />

</RelativeLayout>
